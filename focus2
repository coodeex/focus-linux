#!/usr/bin/env python3
"""Repeat a focus period followed by a fullscreen five-minute break."""

import json
import math
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import tkinter as tk
from datetime import date
from pathlib import Path


BREAK_SECONDS = 5 * 60
DEFAULT_FOCUS_WINDOW_SIZE = 340
DIAL_SECONDS = 60 * 60
FOCUS_WINDOW_FOOTER_HEIGHT = 22
BREAK_SOUND_PATH = Path(__file__).resolve().with_name(
    "Cat Meow Sound Effect ~ Attract Cats, Sounds Cats Love - SoundEffectsFactory.mp3"
)
LAYING_CAT_PATH = Path(__file__).resolve().with_name("laying_cat.png")
ACTIVE_CAT_PATH = Path(__file__).resolve().with_name("active_cat.png")
CAT_REMINDER_SECONDS = 5 * 60


def focus_time_label_y(window_size: int) -> float:
    """Place the label below the dial, in the window's footer area."""
    radius = window_size * 138 / DEFAULT_FOCUS_WINDOW_SIZE
    return window_size / 2 + radius + 20


def stats_path_for_today() -> Path:
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return state_home / "focus2" / f"{date.today().isoformat()}.json"


def settings_path() -> Path:
    return stats_path_for_today().parent / "settings.json"


def load_settings() -> dict:
    defaults = {
        "focus_window_size": DEFAULT_FOCUS_WINDOW_SIZE,
        "focus_window_position": None,
    }
    try:
        saved = json.loads(settings_path().read_text())
    except (OSError, json.JSONDecodeError):
        return defaults

    size = saved.get("focus_window_size")
    if isinstance(size, int) and 120 <= size <= 800:
        defaults["focus_window_size"] = size
    position = saved.get("focus_window_position")
    if (
        isinstance(position, list)
        and len(position) == 2
        and all(isinstance(coordinate, int) for coordinate in position)
    ):
        defaults["focus_window_position"] = position
    return defaults


def save_settings(settings: dict) -> None:
    path = settings_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path = path.with_suffix(".tmp")
    temporary_path.write_text(json.dumps(settings))
    temporary_path.replace(path)


def load_stats() -> dict:
    """Load today's totals, or start a new set of totals."""
    defaults = empty_stats()
    try:
        saved = json.loads(stats_path_for_today().read_text())
    except (OSError, json.JSONDecodeError):
        return defaults

    for key in ("done_count", "focus_minutes", "break_seconds"):
        if isinstance(saved.get(key), int) and saved[key] >= 0:
            defaults[key] = saved[key]
    return defaults


def empty_stats() -> dict:
    """Return a new, zeroed set of daily totals."""
    return {
        "done_count": 0,
        "focus_minutes": 0,
        "break_seconds": 0,
    }


def save_stats(stats: dict) -> None:
    path = stats_path_for_today()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path = path.with_suffix(".tmp")
    temporary_path.write_text(json.dumps(stats))
    temporary_path.replace(path)


def format_minutes(seconds: float) -> str:
    return f"{int(seconds) // 60}min"


def run_playerctl(arguments: list[str]) -> subprocess.CompletedProcess[str] | None:
    """Run playerctl quietly; media control is optional to the timer."""
    try:
        return subprocess.run(
            ["playerctl", *arguments],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
        return None


def pause_playing_media() -> list[str]:
    """Pause every currently playing MPRIS player and return their names."""
    players = run_playerctl(["--list-all"])
    if players is None or players.returncode != 0:
        return []

    paused_players = []
    for player in players.stdout.splitlines():
        status = run_playerctl(["--player", player, "status"])
        if status is None or status.returncode != 0 or status.stdout.strip() != "Playing":
            continue
        pause = run_playerctl(["--player", player, "pause"])
        if pause is not None and pause.returncode == 0:
            paused_players.append(player)
    return paused_players


def resume_media(players: list[str]) -> None:
    """Resume only players that Focus2 paused at the start of a break."""
    for player in players:
        run_playerctl(["--player", player, "play"])


def play_break_sound() -> None:
    """Play the bundled break sound once without blocking the timer."""
    if not BREAK_SOUND_PATH.is_file():
        return
    try:
        if shutil.which("cvlc") is not None:
            subprocess.Popen(
                ["cvlc", "--intf", "dummy", "--play-and-exit", str(BREAK_SOUND_PATH)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            return
        elif shutil.which("ffplay") is not None:
            subprocess.Popen(
                ["ffplay", "-nodisp", "-autoexit", "-loglevel", "error", str(BREAK_SOUND_PATH)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    except OSError:
        pass


def show_focus_window(
    stop_requested: threading.Event, focus_seconds: int, settings: dict, session_day: date
) -> tuple[str, float]:
    """Show a small Time Timer-style dial for one focus period.

    Returns a result plus the elapsed focus seconds. Results are ``complete``, ``break_now``,
    ``new_day``, or ``stopped``. Closing the window merely hides it; the focus timer continues
    in the background.
    """
    if focus_seconds == 0:
        return ("stopped" if stop_requested.is_set() else "complete"), 0

    window_size = settings["focus_window_size"]
    window = tk.Tk()
    window.title("")
    window.configure(background="#121313")
    window.resizable(False, False)
    window.attributes("-topmost", True)

    canvas = tk.Canvas(
        window,
        width=window_size,
        height=window_size + FOCUS_WINDOW_FOOTER_HEIGHT,
        background="#121313",
        highlightthickness=0,
    )
    canvas.pack(padx=12, pady=12)
    saved_position = settings.get("focus_window_position")
    if saved_position is not None:
        window.geometry(f"+{saved_position[0]}+{saved_position[1]}")
    centre = window_size / 2
    radius = window_size * 138 / DEFAULT_FOCUS_WINDOW_SIZE
    dial_bounds = (centre - radius, centre - radius, centre + radius, centre + radius)
    update_id = None
    settings_window = None
    finished = False
    break_requested = False
    new_day = False
    focus_started_at = time.monotonic()
    ends_at = time.monotonic() + focus_seconds

    # Draw the static face once. The colored sector is redrawn on each tick.
    canvas.create_oval(*dial_bounds, fill="#262728", outline="#555657", width=2)
    sector = canvas.create_arc(
        *dial_bounds,
        start=90,
        extent=360,
        fill="#e82b4f",
        outline="",
        style=tk.PIESLICE,
    )
    for minute_mark in range(60):
        angle = minute_mark * 6 - 90
        radians = angle * 3.141592653589793 / 180
        outer = radius + 4.8
        inner = radius - (3.5 if minute_mark % 5 == 0 else 2.5)
        x1 = centre + inner * math.cos(radians)
        y1 = centre + inner * math.sin(radians)
        x2 = centre + outer * math.cos(radians)
        y2 = centre + outer * math.sin(radians)
        canvas.create_line(x1, y1, x2, y2, fill="#d8d8d6", width=2 if minute_mark % 5 == 0 else 1)

    hub_radius = 9 * window_size / DEFAULT_FOCUS_WINDOW_SIZE
    hub_dot_radius = 4 * window_size / DEFAULT_FOCUS_WINDOW_SIZE
    canvas.create_oval(
        centre - hub_radius,
        centre - hub_radius,
        centre + hub_radius,
        centre + hub_radius,
        fill="#151617",
        outline="#4a4b4c",
        width=1,
    )
    canvas.create_oval(
        centre - hub_dot_radius,
        centre - hub_dot_radius,
        centre + hub_dot_radius,
        centre + hub_dot_radius,
        fill="#343536",
        outline="",
    )

    time_text = canvas.create_text(
        centre,
        focus_time_label_y(window_size),
        text="",
        font=("Sans", 11, "bold"),
        fill="#b6b6b3",
    )

    def close_window() -> None:
        nonlocal update_id
        if update_id is not None:
            window.after_cancel(update_id)
            update_id = None
        if window.winfo_ismapped():
            settings["focus_window_position"] = [window.winfo_x(), window.winfo_y()]
            save_settings(settings)
        window.destroy()

    def hide_window() -> None:
        window.withdraw()

    window.protocol("WM_DELETE_WINDOW", hide_window)

    def take_break_now() -> None:
        nonlocal break_requested
        break_requested = True
        close_window()

    def open_settings(_event: tk.Event | None = None) -> None:
        nonlocal settings_window, window_size
        if settings_window is not None and settings_window.winfo_exists():
            settings_window.lift()
            settings_window.focus_set()
            return

        settings_window = tk.Toplevel(window)
        settings_window.title("Focus2 settings")
        settings_window.configure(background="#1c1d1e")
        settings_window.resizable(False, False)
        settings_window.transient(window)
        settings_window.attributes("-topmost", True)

        content = tk.Frame(settings_window, background="#1c1d1e")
        content.pack(padx=24, pady=22)
        tk.Label(
            content,
            text="Clock size (pixels)",
            font=("Sans", 13, "bold"),
            foreground="white",
            background="#1c1d1e",
        ).pack(anchor="w")
        size_value = tk.StringVar(value=str(window_size))
        size_entry = tk.Entry(content, textvariable=size_value, font=("Sans", 14), width=6)
        size_entry.pack(anchor="w", pady=(8, 4))
        size_entry.select_range(0, tk.END)
        size_entry.focus_set()
        error_label = tk.Label(
            content,
            text="Choose a square size from 120 to 800.",
            font=("Sans", 10),
            foreground="#b6b6b3",
            background="#1c1d1e",
        )
        error_label.pack(anchor="w", pady=(0, 16))

        tk.Label(
            content,
            text="Minutes left",
            font=("Sans", 13, "bold"),
            foreground="white",
            background="#1c1d1e",
        ).pack(anchor="w")
        remaining_minutes = math.ceil(max(0, ends_at - time.monotonic()) / 60)
        minutes_value = tk.StringVar(value=str(remaining_minutes))
        minutes_controls = tk.Frame(content, background="#1c1d1e")
        minutes_controls.pack(anchor="w", pady=(8, 4))
        minutes_entry = tk.Entry(minutes_controls, textvariable=minutes_value, font=("Sans", 14), width=6)
        minutes_entry.pack(side="left")
        for minutes in (1, 3, 5, 10, 15):
            tk.Button(
                minutes_controls,
                text=str(minutes),
                command=lambda amount=minutes: minutes_value.set(str(amount)),
                font=("Sans", 10, "bold"),
                foreground="white",
                background="#495057",
                activebackground="#5b646c",
                activeforeground="white",
                borderwidth=0,
                padx=8,
                pady=4,
            ).pack(side="left", padx=(5, 0))
        tk.Label(
            content,
            text="Set the remaining time in whole minutes.",
            font=("Sans", 10),
            foreground="#b6b6b3",
            background="#1c1d1e",
        ).pack(anchor="w", pady=(0, 16))

        tk.Button(
            content,
            text="Have a break now",
            command=take_break_now,
            font=("Sans", 12, "bold"),
            foreground="white",
            background="#149447",
            activebackground="#0f7939",
            activeforeground="white",
            borderwidth=0,
            padx=24,
            pady=11,
        ).pack(anchor="w", pady=(0, 12))

        def close_settings() -> None:
            nonlocal settings_window
            settings_window.destroy()
            settings_window = None

        def apply_settings() -> None:
            nonlocal ends_at, window_size
            try:
                new_size = int(size_value.get())
            except ValueError:
                new_size = 0
            if not 120 <= new_size <= 800:
                error_label.configure(text="Enter a whole number from 120 to 800.", foreground="#ff8a9b")
                return

            try:
                new_minutes = int(minutes_value.get())
            except ValueError:
                new_minutes = -1
            if new_minutes < 0:
                error_label.configure(text="Enter whole minutes greater than or equal to zero.", foreground="#ff8a9b")
                return

            scale = new_size / window_size
            canvas.scale("all", 0, 0, scale, scale)
            canvas.configure(width=new_size, height=new_size + FOCUS_WINDOW_FOOTER_HEIGHT)
            canvas.coords(time_text, new_size / 2, focus_time_label_y(new_size))
            window.geometry("")
            window_size = new_size
            settings["focus_window_size"] = new_size
            save_settings(settings)
            ends_at = time.monotonic() + new_minutes * 60
            close_settings()

        tk.Button(
            content,
            text="Save",
            command=apply_settings,
            font=("Sans", 12, "bold"),
            foreground="white",
            background="#495057",
            activebackground="#5b646c",
            activeforeground="white",
            borderwidth=0,
            padx=20,
            pady=8,
        ).pack(anchor="e")
        settings_window.protocol("WM_DELETE_WINDOW", close_settings)
        settings_window.bind("<Return>", lambda _event: apply_settings())

    canvas.bind("<Button-1>", open_settings)

    def update_dial() -> None:
        nonlocal finished, new_day, update_id
        if stop_requested.is_set():
            close_window()
            return
        if date.today() != session_day:
            new_day = True
            close_window()
            return

        seconds_left = max(0, ends_at - time.monotonic())
        # The face is always a 60-minute clock: a 30-minute focus period
        # begins with a half-circle, and each remaining minute is six degrees.
        progress = min(1, seconds_left / DIAL_SECONDS)
        minutes = math.ceil(seconds_left / 60)
        canvas.itemconfigure(sector, extent=360 * progress)
        canvas.itemconfigure(time_text, text=f"{minutes} min")

        if seconds_left == 0:
            finished = True
            close_window()
            return
        update_id = window.after(200, update_dial)

    update_dial()
    window.mainloop()
    elapsed_seconds = min(focus_seconds, max(0, time.monotonic() - focus_started_at))
    if break_requested:
        return "break_now", elapsed_seconds
    if new_day:
        return "new_day", elapsed_seconds
    return ("complete" if finished else "stopped"), elapsed_seconds


def show_break_window(
    stop_requested: threading.Event, stats: dict, session_day: date, waiting_for_new_day: bool = False
) -> tuple[float, bool, bool]:
    """Show a break window, or wait for the user to explicitly start a new day."""
    window = tk.Tk()
    window.title("Have a Break")
    window.configure(background="#102018")
    window.attributes("-fullscreen", True)
    window.attributes("-topmost", True)
    window.bind("<Escape>", lambda _event: None)  # Keep the break window visible.

    content = tk.Frame(window, background="#102018")
    content.place(relx=0.5, rely=0.5, anchor="center")
    countdown_update_id = None
    done_pressed = False
    new_day_started = False
    rollover_active = waiting_for_new_day
    cat_petted = False
    break_started_at = time.monotonic()

    def close_window() -> None:
        nonlocal countdown_update_id
        if countdown_update_id is not None:
            window.after_cancel(countdown_update_id)
            countdown_update_id = None
        window.destroy()

    def finish_break() -> None:
        nonlocal done_pressed
        done_pressed = True
        close_window()

    def start_new_day() -> None:
        nonlocal new_day_started
        new_day_started = True
        close_window()

    heading = tk.Label(
        content,
        text="New Day" if waiting_for_new_day else "Have a Break",
        font=("Sans", 56, "bold"),
        foreground="white",
        background="#102018",
    )
    heading.pack(pady=(0, 28))

    countdown = tk.Label(
        content,
        font=("Sans", 72, "bold"),
        foreground="#b9f6ca",
        background="#102018",
        cursor="hand2",
    )
    countdown.pack(pady=(0, 42))

    stats_table = tk.Frame(content, background="#102018")
    stats_table.pack(pady=(0, 32))
    stats_font = ("DejaVu Sans Mono", 20, "bold")
    focus_label = tk.Label(
        stats_table, font=stats_font, foreground="#d6eadb", background="#102018", cursor="hand2"
    )
    focus_label.grid(row=0, column=0, padx=(0, 18))
    tk.Label(
        stats_table,
        text="│",
        font=stats_font,
        foreground="#5f7a68",
        background="#102018",
    ).grid(row=0, column=1)
    break_label = tk.Label(
        stats_table, font=stats_font, foreground="#d6eadb", background="#102018", cursor="hand2"
    )
    break_label.grid(row=0, column=2, padx=(18, 0))
    # Keep done_count in the daily data, but hide its UI row for now.
    # done_label = tk.Label(
    #     stats_table,
    #     font=("DejaVu Sans Mono", 20),
    #     foreground="#d6eadb",
    #     background="#102018",
    #     cursor="hand2",
    # )
    # done_label.grid(row=1, column=0, columnspan=3, pady=(12, 0))

    action_button = tk.Button(
        content,
        text="Start a Day" if waiting_for_new_day else "Done",
        command=start_new_day if waiting_for_new_day else finish_break,
        font=("Sans", 36, "bold"),
        foreground="white",
        background="#149447",
        activebackground="#0f7939",
        activeforeground="white",
        borderwidth=0,
        cursor="hand2",
        padx=100,
        pady=32,
    )

    def load_cat_image(path: Path) -> tk.PhotoImage | None:
        """Load a bundled, display-ready cat image at roughly 200 pixels wide."""
        try:
            image = tk.PhotoImage(file=path)
        except tk.TclError:
            return None
        return image.subsample(max(1, image.width() // 200), max(1, image.width() // 200))

    active_cat_image = load_cat_image(ACTIVE_CAT_PATH)
    laying_cat_image = load_cat_image(LAYING_CAT_PATH)
    cat_area = tk.Frame(content, background="#102018", width=200, height=180)
    cat_area.pack(pady=(0, 24))
    cat_area.pack_propagate(False)
    cat_image = tk.Label(cat_area, background="#102018", cursor="hand2")
    cat_image.pack()
    pet_button = tk.Button(
        cat_area,
        text="Pet",
        font=("Sans", 14, "bold"),
        foreground="#d6eadb",
        background="#244536",
        activebackground="#315b47",
        activeforeground="white",
        borderwidth=0,
        cursor="hand2",
        padx=20,
        pady=10,
    )
    def place_pet_button(image: tk.PhotoImage | None) -> None:
        image_height = image.height() if image is not None else 0
        pet_button.place(relx=0.5, x=0, y=image_height - 5, anchor="n")

    def pet_cat(_event: tk.Event | None = None) -> None:
        """Silence this break's reminders and show the cat's active state."""
        nonlocal cat_petted, next_meow_at
        if not cat_petted:
            cat_petted = True
            if laying_cat_image is not None:
                cat_image.configure(image=laying_cat_image, text="")
                cat_image.image = laying_cat_image
                place_pet_button(laying_cat_image)
            else:
                cat_image.configure(text="Cat petted", foreground="#b9f6ca", font=("Sans", 14, "bold"))
            pet_button.configure(text="Unpet")
            return

        cat_petted = False
        next_meow_at = time.monotonic()
        if active_cat_image is not None:
            cat_image.configure(image=active_cat_image, text="")
            cat_image.image = active_cat_image
            place_pet_button(active_cat_image)
        else:
            cat_image.configure(text="Pet", foreground="#d6eadb", font=("Sans", 14, "bold"))
        pet_button.configure(text="Pet")

    if active_cat_image is not None:
        cat_image.configure(image=active_cat_image)
        cat_image.image = active_cat_image
        place_pet_button(active_cat_image)
    else:
        cat_image.configure(text="Pet", foreground="#d6eadb", font=("Sans", 14, "bold"))
        place_pet_button(None)
    cat_image.bind("<ButtonRelease-1>", pet_cat)
    pet_button.configure(command=pet_cat)

    action_button.pack()

    ends_at = time.monotonic() + BREAK_SECONDS
    next_meow_at = ends_at

    def edit_break_length(_event: tk.Event | None = None) -> None:
        """Set the remaining break length, with quick extension buttons."""
        nonlocal ends_at, next_meow_at
        editor = tk.Toplevel(window)
        editor.title("Break time")
        editor.configure(background="#1c1d1e")
        editor.resizable(False, False)
        editor.transient(window)
        editor.attributes("-topmost", True)
        editor.lift()
        editor.focus_force()

        editor_content = tk.Frame(editor, background="#1c1d1e")
        editor_content.pack(padx=24, pady=22)
        tk.Label(
            editor_content,
            text="Break time remaining (minutes)",
            font=("Sans", 13, "bold"),
            foreground="white",
            background="#1c1d1e",
        ).pack(anchor="w")
        remaining_minutes = math.ceil(max(0, ends_at - time.monotonic()) / 60)
        value = tk.StringVar(value=str(remaining_minutes))
        entry = tk.Entry(editor_content, textvariable=value, font=("Sans", 14), width=8)
        entry.pack(anchor="w", pady=(8, 4))
        entry.select_range(0, tk.END)
        entry.focus_set()
        error = tk.Label(
            editor_content,
            text="Minutes may include decimals (0.01 = 1 second).",
            font=("Sans", 10),
            foreground="#b6b6b3",
            background="#1c1d1e",
        )
        error.pack(anchor="w", pady=(0, 12))

        quick_add = tk.Frame(editor_content, background="#1c1d1e")
        quick_add.pack(anchor="w", pady=(0, 16))

        def add_minutes(minutes: int) -> None:
            try:
                current = int(value.get())
            except ValueError:
                current = 0
            value.set(str(max(0, current) + minutes))
            entry.focus_set()

        for minutes in (5, 15, 30, 45):
            tk.Button(
                quick_add,
                text=f"+{minutes}",
                command=lambda amount=minutes: add_minutes(amount),
                font=("Sans", 11, "bold"),
                foreground="white",
                background="#495057",
                activebackground="#5b646c",
                activeforeground="white",
                borderwidth=0,
                padx=10,
                pady=6,
            ).pack(side="left", padx=(0, 6))

        def apply_break_length() -> None:
            nonlocal ends_at
            try:
                minutes = float(value.get())
            except ValueError:
                minutes = -1.0
            if minutes < 0:
                error.configure(text="Enter a number greater than or equal to zero.", foreground="#ff8a9b")
                return
            ends_at = time.monotonic() + math.ceil(minutes * 60)
            next_meow_at = ends_at
            editor.destroy()

        tk.Button(
            editor_content,
            text="Save",
            command=apply_break_length,
            font=("Sans", 12, "bold"),
            foreground="white",
            background="#149447",
            activebackground="#0f7939",
            activeforeground="white",
            borderwidth=0,
            padx=20,
            pady=8,
        ).pack(anchor="e")
        editor.bind("<Return>", lambda _event: apply_break_length())

    def edit_total(kind: str) -> None:
        """Open a small editor for one of today's displayed totals."""
        nonlocal break_started_at
        titles = {
            "focus": ("Focus minutes", "minutes", stats["focus_minutes"]),
            "break": (
                "Break minutes",
                "minutes",
                int((stats["break_seconds"] + time.monotonic() - break_started_at) // 60),
            ),
            "done": ("Done count", "times", stats["done_count"]),
        }
        title, unit, current_value = titles[kind]
        editor = tk.Toplevel(window)
        editor.title(title)
        editor.configure(background="#1c1d1e")
        editor.resizable(False, False)
        editor.transient(window)
        editor.attributes("-topmost", True)

        content = tk.Frame(editor, background="#1c1d1e")
        content.pack(padx=24, pady=22)
        tk.Label(
            content,
            text=title,
            font=("Sans", 13, "bold"),
            foreground="white",
            background="#1c1d1e",
        ).pack(anchor="w")
        value = tk.StringVar(value=str(current_value))
        entry = tk.Entry(content, textvariable=value, font=("Sans", 14), width=8)
        entry.pack(anchor="w", pady=(8, 4))
        entry.select_range(0, tk.END)
        entry.focus_set()
        error = tk.Label(
            content,
            text=f"Enter a whole number of {unit}.",
            font=("Sans", 10),
            foreground="#b6b6b3",
            background="#1c1d1e",
        )
        error.pack(anchor="w", pady=(0, 16))

        def apply_total() -> None:
            nonlocal break_started_at
            try:
                new_value = int(value.get())
            except ValueError:
                new_value = -1
            if new_value < 0:
                error.configure(text="Enter a whole number greater than or equal to zero.", foreground="#ff8a9b")
                return

            if kind == "focus":
                stats["focus_minutes"] = new_value
            elif kind == "break":
                stats["break_seconds"] = new_value * 60
                break_started_at = time.monotonic()
            else:
                stats["done_count"] = new_value
            save_stats(stats)
            editor.destroy()

        tk.Button(
            content,
            text="Save",
            command=apply_total,
            font=("Sans", 12, "bold"),
            foreground="white",
            background="#149447",
            activebackground="#0f7939",
            activeforeground="white",
            borderwidth=0,
            padx=20,
            pady=8,
        ).pack(anchor="e")
        editor.bind("<Return>", lambda _event: apply_total())

    focus_label.bind("<Button-1>", lambda _event: edit_total("focus"))
    break_label.bind("<Button-1>", lambda _event: edit_total("break"))
    # done_label.bind("<Button-1>", lambda _event: edit_total("done"))
    countdown.bind("<ButtonRelease-1>", edit_break_length)

    def activate_new_day() -> None:
        heading.configure(text="New Day")
        countdown.configure(text="")
        action_button.configure(text="Start a Day", command=start_new_day)
        focus_label.configure(text="Focus 0min")
        break_label.configure(text="Break 0min")
        # done_label.configure(text="Done 0 times")

    def update_countdown() -> None:
        nonlocal countdown_update_id, rollover_active, next_meow_at
        if stop_requested.is_set():
            close_window()
            return

        if not rollover_active and date.today() != session_day:
            rollover_active = True
            activate_new_day()

        if rollover_active:
            countdown_update_id = window.after(200, update_countdown)
            return

        seconds_left = ends_at - time.monotonic()
        remaining = max(0, int(seconds_left + 0.999))
        minutes, seconds = divmod(remaining, 60)
        countdown.configure(text=f"{minutes:02d}:{seconds:02d}")
        if seconds_left <= 0 and not cat_petted and time.monotonic() >= next_meow_at:
            play_break_sound()
            next_meow_at = time.monotonic() + CAT_REMINDER_SECONDS
        focus_label.configure(text=f"Focus {stats['focus_minutes']}min")
        break_label.configure(
            text=f"Break {format_minutes(stats['break_seconds'] + time.monotonic() - break_started_at)}"
        )
        # done_label.configure(text=f"Done {stats['done_count']} times")
        countdown_update_id = window.after(50, update_countdown)

    update_countdown()
    window.mainloop()
    return time.monotonic() - break_started_at, done_pressed, new_day_started


def main() -> int:
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <focus-minutes>", file=sys.stderr)
        return 2

    try:
        focus_minutes = int(sys.argv[1])
        if focus_minutes < 0:
            raise ValueError
    except ValueError:
        print("Focus minutes must be a whole number greater than or equal to zero.", file=sys.stderr)
        return 2

    focus_seconds = focus_minutes * 60
    print(f"Focus2 started: a break window will open every {focus_minutes} minute(s).")

    stop_requested = threading.Event()
    stats = load_stats()
    settings = load_settings()
    session_day = date.today()
    signal.signal(signal.SIGINT, lambda _signum, _frame: stop_requested.set())

    while not stop_requested.is_set():
        focus_result, elapsed_focus_seconds = show_focus_window(
            stop_requested, focus_seconds, settings, session_day
        )
        if focus_result == "stopped":
            break
        if focus_result == "new_day":
            paused_players = pause_playing_media()
            _, _, new_day_started = show_break_window(
                stop_requested, empty_stats(), date.today(), waiting_for_new_day=True
            )
            if not new_day_started:
                break
            resume_media(paused_players)
            session_day = date.today()
            stats = load_stats()
            continue
        if focus_result == "complete":
            stats["focus_minutes"] += focus_minutes
            save_stats(stats)
        elif focus_result == "break_now":
            stats["focus_minutes"] += int(elapsed_focus_seconds // 60)
            save_stats(stats)

        paused_players = pause_playing_media()
        break_seconds, done_pressed, new_day_started = show_break_window(stop_requested, stats, session_day)
        if date.today() != session_day and not new_day_started:
            _, _, new_day_started = show_break_window(
                stop_requested, empty_stats(), date.today(), waiting_for_new_day=True
            )
        if new_day_started:
            resume_media(paused_players)
            session_day = date.today()
            stats = load_stats()
            continue
        if stop_requested.is_set():
            break
        stats["break_seconds"] += round(break_seconds)
        if done_pressed:
            stats["done_count"] += 1
            resume_media(paused_players)
        save_stats(stats)

    print("Focus2 stopped.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
